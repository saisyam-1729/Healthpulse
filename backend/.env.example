# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Required
MONGO_URI=mongodb://127.0.0.1:27017/healthcompanion
JWT_SECRET=change-me-to-a-long-random-string
DEVICE_API_KEY=change-me-must-match-the-ESP32-firmware-key

# Server
PORT=5001
FRONTEND_URL=http://localhost:5173

# Python ai_service (Flask). Its real default port is 5002.
AI_SERVICE_URL=http://localhost:5002

# Diffusion endpoints on the same Flask service (used by /api/diffusion/*).
# Leave unset to use AI_SERVICE_URL.
DIFFUSION_SERVICE_URL=
DIFFUSION_TIMEOUT_MS=30000

# Optional third-party LLM keys
GROQ_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
