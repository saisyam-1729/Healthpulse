# Frontend build-time settings (Vite). Copy to .env.local; never commit real values.

# Backend base URL used by the admin export links and the map page.
VITE_API_URL=http://localhost:5001

# Show the research forecast panel to every user (default: admins only).
# Keep this off in production until the model is validated on HealthPulse device data.
VITE_ENABLE_FORECAST_PANEL=false
